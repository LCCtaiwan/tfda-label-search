          ],
          "content_text": "目前尚無資訊。",
          "content_html": "<p><span style=\"color:black;\">目前尚無資訊。</span></p>",
          "search_text": "10.1\n作用機轉\n目前尚無資訊。",
          "images": [],
          "style": {
